<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="my_pipe">
    <static>true</static> <!-- объект не двигается -->

    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://my_pipe/meshes/pipe.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://my_pipe/meshes/pipe.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>
